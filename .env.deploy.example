# Never commit .env.deploy. Use a new dedicated deployer wallet, funded only with deployment gas.
DEPLOYER_PRIVATE_KEY=

# Archive-capable Robinhood mainnet RPC used by fork tests and deployment simulation.
ROBINHOOD_ARCHIVE_RPC_URL=

# Three distinct hardware-wallet/owner addresses used to create a 2-of-3 Robinhood Safe.
SAFE_OWNER_1=
SAFE_OWNER_2=
SAFE_OWNER_3=
SAFE_SALT_NONCE=1

# Public Safe addresses — no private keys.
GOVERNANCE_SAFE=
OPS_SAFE=

# Live v2 contracts (Robinhood mainnet).
UNIVERSAL_REWARDS_HUB=0x6844D0814E904722777A48Ae2CF7C4b8F78a19e5
PROJECT_ROUTER_FACTORY=0x4AD615B99e2B6E8e2C322c657Ac8f81F1806A3a7

# Round-operator Safe. May be the same address as GOVERNANCE_SAFE for a single-operator v1.
# Community root/manifest commitments are signed by each ProjectRouter.projectAdmin, not this Safe.
SNAPSHOT_SIGNER=

# Mainnet deployment hardcodes canonical Robinhood $SPY as settlement asset.
HUB_FEE_BPS=500

# Content-addressed manifest mirror directory for the dry-run worker (optional).
MANIFEST_DIR=

# Fixed hourly worker cadence (minimum 1 hour).
WORKER_POLL_INTERVAL_MS=3600000

# Mainnet reference values.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SPY_ADDRESS=0x117cc2133c37B721F49dE2A7a74833232B3B4C0C
