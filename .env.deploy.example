# Never commit .env.deploy. Use a new dedicated deployer wallet, funded only with deployment gas.
DEPLOYER_PRIVATE_KEY=

# Use Robinhood Chain TESTNET first (chain ID 46630).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Public Safe addresses only. These may be the same Safe for the initial test.
GOVERNANCE_SAFE=
OPS_SAFE=

# The contract's settlement asset. On testnet, use the canonical testnet WETH address.
# For mainnet, use canonical $SPY only after testnet verification and review.
SETTLEMENT_ASSET=0x7943e237c7F95DA44E0301572D358911207852Fa
HUB_FEE_BPS=500

# Mainnet reference values — do not use for a first deployment.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SPY_ADDRESS=0x117cc2133c37B721F49dE2A7a74833232B3B4C0C
